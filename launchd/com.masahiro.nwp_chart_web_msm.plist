<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- MSM（ローカル専用）の自動取得: 00/12/18UTC初期値（00/12は78h、18は39hまで）を、1時間おきに確認して揃っていれば取得・作図。
       作成済みなら数秒で終わる。3日より古いPNGとGRIB2は削除する。03/06/09/15/21UTCは手動で取得する（画面の「過去分取得」）。 -->
  <key>Label</key><string>com.masahiro.nwp_chart_web_msm</string>
  <key>ProgramArguments</key>
  <array>
    <!-- brew更新でpython3が切り替わる事故を避けるため、condaのPythonを絶対パスで指定 -->
    <string>/opt/anaconda3/envs/met_env_310/bin/python</string>
    <string>/Users/masahiro/projects/nwp_chart_web/update_latest.py</string>
    <string>--models</string><string>msm</string>
    <string>--init-hours</string><string>0</string><string>12</string><string>18</string>
    <string>--keep-days</string><string>3</string>
    <string>--jobs</string><string>4</string>
    <string>--dl-jobs</string><string>6</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/masahiro/projects/nwp_chart_web</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/masahiro/projects/nwp_chart_web/logs/msm_auto.log</string>
  <key>StandardErrorPath</key><string>/Users/masahiro/projects/nwp_chart_web/logs/msm_auto.log</string>
</dict>
</plist>
